  "modelFunctions": {
    "initial": "function initial(character='orbit',seed=1030){return {character,seed,levels:{[character+'.root']:1},picks:[]};}",
    "eligible": "function eligible(c,s){return (s.levels[c.id]||0)<c.cap&&(!c.parent||(s.levels[c.parent]||0)>=(c.parentLevel||1));}",
    "offers": "function offers(s){if(s.picks.length>=5)return [];return ['trait','base','risk'].map(slot=>{const pool=catalog.filter(c=>c.slot===slot&&eligible(c,s));if(!pool.length)throw Error('empty '+slot);return pool[hash(s.seed+'|'+s.character+'|'+s.picks.join(',')+'|'+slot)%pool.length];});}",
    "choose": "function choose(s,id){if(!offers(s).some(c=>c.id===id))throw Error('Card is not currently offered');return {...s,levels:{...s.levels,[id]:(s.levels[id]||0)+1},picks:[...s.picks,id]};}",
    "config": "function config(s){const l=id=>s.levels[id]||0;return {character:s.character,mechanisms:Object.keys(names).filter(k=>l(k+'.root')),damage:1,health:1+.10*l('base.health'),speed:1,basicSpeed:1+.10*l('base.speed'),basicRange:1+.10*l('base.range'),traits:{orbitCount:2+l('orbit.more'),orbitRadius:76+12*l('orbit.wide'),ricochetBounces:1+l('crit.chain')+l('crit.relay'),ricochetRange:120+45*l('crit.reach'),honeyRadius:103+14*l('honey.wide'),honeySlow:.45-.10*l('honey.sticky'),summonCount:Math.min(4,(s.character==='summon'?2:1)+l('summon.team')),impactRange:68+6*l('bounce.reach'),impactForce:220+35*l('bounce.force')},risks:{enemyHealth:1+.5*l('risk.bounty'),coinMultiplier:1+l('risk.bounty'),basicDamage:l('risk.glass')?1.6:1,playerHealth:l('risk.glass')?.65:1,enemySpeed:1+.2*l('risk.fleet'),playerSpeed:1+.2*l('risk.fleet')},ownedLevels:{...s.levels}};}"
  }
