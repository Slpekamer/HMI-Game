 static IEnumerable<Node> Walk(Node n){yield return n;foreach(Node c in n.GetChildren())foreach(var x in Walk(c))yield return x;}
 async System.Threading.Tasks.Task Flush(){for(int i=0;i<3;i++)await ToSignal(GetTree(),SceneTree.SignalName.ProcessFrame);}
 T Field<T>(GameUi ui,string name)=>(T)typeof(GameUi).GetField(name,Flags).GetValue(ui);
 void Fit(GameUi ui,bool overlay=false)
 {
  var scope=Field<Control>(ui,overlay?"_overlay":"_screen");var width=scope.Size.X;
  foreach(var b in Walk(scope).OfType<Button>().Where(c=>c.IsVisibleInTree()))
  {
   Check(b.Position.X>=-1&&b.Position.X+b.Size.X<=width+1,"Button horizontal bounds: "+b.Text+" "+b.Position+" "+b.Size+" width="+width);
   float text=b.GetThemeFont("font").GetStringSize(b.Text,HorizontalAlignment.Left,-1,b.GetThemeFontSize("font_size")).X;
   Check(text<=b.Size.X-12,"Full button text fit: "+b.Text);
  }
 }
 async System.Threading.Tasks.Task Capture(string stage)
 {
  var arg=OS.GetCmdlineUserArgs().FirstOrDefault(s=>s.StartsWith("--capture-responsive="));if(arg==null)return;
  await ToSignal(RenderingServer.Singleton,RenderingServer.SignalName.FramePostDraw);
  Check(GetViewport().GetTexture().GetImage().SavePng(arg.Substring(21)+"-"+stage+".png")==Error.Ok,"Actual capture");
 }
