 void Check(bool ok,string reason){checks++;if(!ok)throw new Exception(reason);}
 static IEnumerable<Node> Walk(Node n){yield return n;if(n is SubViewport)yield break;foreach(Node c in n.GetChildren())foreach(var x in Walk(c))yield return x;}
 async System.Threading.Tasks.Task Flush(){for(int i=0;i<3;i++)await ToSignal(GetTree(),SceneTree.SignalName.ProcessFrame);}
 static object Rect(Rect2 r)=>new{x=r.Position.X,y=r.Position.Y,width=r.Size.X,height=r.Size.Y};
 static float Area(Rect2 a,Rect2 b){var r=a.Intersection(b);return r.HasArea()?r.Size.X*r.Size.Y:0;}
 static float UnionArea(Rect2 bound,Rect2[] rectangles){
 var clipped=rectangles.Select(r=>r.Intersection(bound)).Where(r=>r.HasArea()).ToArray();var xs=clipped.SelectMany(r=>new[]{r.Position.X,r.End.X}).Distinct().OrderBy(x=>x).ToArray();float area=0;
 for(int i=1;i<xs.Length;i++){float left=xs[i-1],right=xs[i],mid=(left+right)*.5f;var intervals=clipped.Where(r=>r.Position.X<=mid&&r.End.X>=mid).OrderBy(r=>r.Position.Y).ToArray();float bottom=0,top=0,total=0;bool first=true;
 foreach(var r in intervals){if(first){bottom=r.Position.Y;top=r.End.Y;first=false;}else if(r.Position.Y>top){total+=top-bottom;bottom=r.Position.Y;top=r.End.Y;}else top=Math.Max(top,r.End.Y);}if(!first)total+=top-bottom;area+=(right-left)*total;}return area;
 }
