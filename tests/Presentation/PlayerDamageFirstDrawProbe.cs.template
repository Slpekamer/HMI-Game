 }catch(Exception e){GD.PushError(e.ToString());GetTree().Quit(1);}}
 void Capture(string name,int bits){using(var root=GetTree().Root.GetTexture().GetImage())root.SavePng(folder+"/"+name+"-root.png");using(var game=view.GetTexture().GetImage()){game.SavePng(folder+"/"+name+"-game.png");int actual=0;for(int i=0;i<8;i++)if(game.GetPixel(14+i*14,702).R>.5f)actual|=1<<i;if(actual!=bits)throw new Exception("DRAW_STAMP_MISMATCH expected="+bits+" actual="+actual);}}
 public override async void _Process(double ignored){if(!ready)return;try{
 if(host.IsProcessing())throw new Exception("automatic host processing");var events=new List<object>();int enemyDamage=0;long before=sim.Tick;sim.TryGetEntity(sim.PlayerId,out var beforePlayer);float hpBefore=beforePlayer.Health;
 for(int j=0;j<8;j++){reference.Enqueue(new GameCommand(CommandKind.Move,x:0,y:0,runToken:reference.RunToken,wave:reference.Wave));reference.Step();for(int i=0;i<reference.EventCount;i++){var e=reference.GetEvent(i);if(e.Kind==EventKind.Damage&&e.Target==reference.PlayerId){enemyDamage++;events.Add(new{index=i,e.Tick,Source=e.Source.ToString(),Target=e.Target.ToString(),e.Value,Mechanism=e.Mechanism.ToString(),FromX=e.From.X,FromY=e.From.Y,ToX=e.To.X,ToY=e.To.Y});}}if(reference.Phase!=RunPhase.Combat||reference.Paused)break;}
 host._Process(.25);var w=GetWindow();w.ContentScaleSize=new(1280,720);w.ContentScaleMode=Window.ContentScaleModeEnum.Viewport;w.ContentScaleAspect=Window.ContentScaleAspectEnum.Keep;
 if(State(sim)!=State(reference))throw new Exception("reference/Host diverged at frame"+frame);File.AppendAllText(folder+"/authority.tsv",frame+"|"+State(sim)+"\n");
 label.Text=(baseline?"A OFF / ":"B ON / ")+"FIRST DRAW DIAGNOSTIC / natural spawn / 8-tick catchup, not FPS benchmark / tick "+sim.Tick;
