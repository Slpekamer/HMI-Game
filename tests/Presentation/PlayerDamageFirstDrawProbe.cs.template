 const BindingFlags F=BindingFlags.Instance|BindingFlags.NonPublic;
 GameHost host;GameSimulation sim,reference;SubViewport view;Label label;ColorRect[] stamp=new ColorRect[8];string folder;int frame;bool ready,baseline;
 T Field<T>(string n)=>(T)typeof(GameHost).GetField(n,F).GetValue(host);
 string State(GameSimulation s){var b=new StringBuilder();var run=typeof(GameSimulation).GetField("Run",F).GetValue(s);b.AppendJoin('|',s.Tick,s.Phase,s.Paused,s.Coins,run.GetType().GetField("Random",F).GetValue(run));for(int i=0;i<s.Capacity;i++)if(s.TryGetEntityAtSlot(i,out var e))b.Append('|').Append(e.Id).Append(':').Append(e.Kind).Append(':').Append(e.Position.X.ToString("R")).Append(',').Append(e.Position.Y.ToString("R")).Append(':').Append(e.Health.ToString("R"));for(int i=0;i<s.EventCount;i++){var e=s.GetEvent(i);b.Append('|').Append(e.Kind).Append(':').Append(e.Source).Append('>').Append(e.Target).Append(':').Append(e.Value.ToString("R"));}return b.ToString();}
 object PlayerVisual(){var presentation=Field<CharacterPresentation[]>("_presentations")[sim.PlayerId.Index];var mixer=presentation==null?null:(FoodAnimationMixer)typeof(CharacterPresentation).GetField("_mixer",F).GetValue(presentation);var values=new List<object>();void Walk(Node n){if(n is MeshInstance3D m&&m.Mesh!=null)foreach(string shape in new[]{"Blink","Smile","Surprise"}){int i=m.FindBlendShapeByName(shape);if(i>=0)values.Add(new{mesh=m.Name.ToString(),shape,value=m.GetBlendShapeValue(i)});}foreach(Node c in n.GetChildren())Walk(c);}var root=Field<Node3D[]>("_visuals")[sim.PlayerId.Index];if(root!=null)Walk(root);return new{clip=presentation?.CurrentClip,attackActive=mixer?.AttackActive??false,morph=values};}
 public override void _Ready(){try{
 folder=OS.GetEnvironment("READY_OUTPUT");Directory.CreateDirectory(folder);GetWindow().Size=new(1280,720);
 var container=new SubViewportContainer{Size=new(1280,720),Stretch=false,MouseFilter=Control.MouseFilterEnum.Ignore};AddChild(container);view=new SubViewport{Size=new(1280,720),OwnWorld3D=true,HandleInputLocally=true,RenderTargetUpdateMode=SubViewport.UpdateMode.Always};container.AddChild(view);host=new GameHost();view.AddChild(host);host.SetProcess(false);baseline=OS.GetEnvironment("PLAYER_DAMAGE_BASELINE")=="1";if(baseline){Field<PlayerDamageMaterial>("_playerDamage").Dispose();typeof(GameHost).GetField("_playerDamage",F).SetValue(host,null);}typeof(GameHost).GetMethod("Start",F).Invoke(host,new object[]{1,(uint)1030});host.SetProcess(false);sim=Field<GameSimulation>("_sim");
 var content=JsonSerializer.Deserialize<GameContent>(Godot.FileAccess.GetFileAsBytes("res://content/gameplay.json"),new JsonSerializerOptions{PropertyNameCaseInsensitive=true});reference=new GameSimulation(content);reference.StartRun("crit",1030);
 var layer=new CanvasLayer{Layer=100};view.AddChild(layer);label=new Label{Position=new(240,687),MouseFilter=Control.MouseFilterEnum.Ignore};label.AddThemeFontSizeOverride("font_size",13);layer.AddChild(label);
 for(int i=0;i<8;i++){stamp[i]=new ColorRect{Position=new(8+i*14,696),Size=new(12,12),Color=Colors.Black,MouseFilter=Control.MouseFilterEnum.Ignore};layer.AddChild(stamp[i]);}
