 File.WriteAllText(folder+"/first-draw.json",JsonSerializer.Serialize(new{frame,before,tick,steps=tick-before,events,hpBefore,hpAfter=sim.TryGetEntity(sim.PlayerId,out var afterPlayer)?afterPlayer.Health:-1,playerId=sim.PlayerId.ToString(),playerVisual=PlayerVisual(),cues=snap,mode=baseline?"test-only player material OFF before Start":"default-player-material",stamp=bits,note="No setup teleport, HP change, cadence edit or pre-render repair. Reference Core captures all 8 steps and is state-equal to actual Host. First FramePostDraw only."},new JsonSerializerOptions{WriteIndented=true,IncludeFields=true}));
 bool headless=OS.GetEnvironment("PLAYER_FIRST_HEADLESS")=="1";
 if(!headless){await ToSignal(RenderingServer.Singleton,RenderingServer.SignalName.FramePostDraw);if(sim.Tick!=tick||feedback?.StateSignature!=state)throw new Exception("state changed before first draw");Capture("first",bits);}
 GD.Print("NATURAL_PLAYER_FIRST_PASS tick="+tick+" steps="+(tick-before)+" damage="+enemyDamage+" stamp="+bits+" headless="+headless);
 var nextEvents=new List<object>();for(int j=0;j<8;j++){reference.Enqueue(new GameCommand(CommandKind.Move,x:0,y:0,runToken:reference.RunToken,wave:reference.Wave));reference.Step();for(int i=0;i<reference.EventCount;i++){var e=reference.GetEvent(i);if(e.Kind==EventKind.Damage&&e.Target==reference.PlayerId)nextEvents.Add(new{e.Tick,index=i,Source=e.Source.ToString(),Target=e.Target.ToString()});}}
 host._Process(.25);if(State(sim)!=State(reference))throw new Exception("expiry batch reference differs");if(feedback?.Active==true)throw new Exception("expiry render was not dark");var next=feedback==null?null:new{feedback.Active,feedback.Age,feedback.Alpha};
 int nextBits=(bits+1)&255;for(int i=0;i<8;i++)stamp[i].Color=(nextBits&(1<<i))!=0?Colors.White:Colors.Black;label.Text=(baseline?"A OFF / ":"B ON / ")+"EXPIRY DIAGNOSTIC / old group expired; new real groups allowed / tick "+sim.Tick;long nextTick=sim.Tick;string nextState=feedback?.StateSignature;
 File.WriteAllText(folder+"/expiry.json",JsonSerializer.Serialize(new{tick=nextTick,oldScope=new{sim.RunToken,sim.Wave},newEvents=nextEvents,remaining=next,stamp=nextBits,note="Old group identity expiry, not unconditional whole-pool emptiness. Next batch is actual Host .25 and reference eight Steps."},new JsonSerializerOptions{WriteIndented=true,IncludeFields=true}));File.AppendAllText(folder+"/authority.tsv","expiry|"+State(sim)+"\n");
 if(!headless){await ToSignal(RenderingServer.Singleton,RenderingServer.SignalName.FramePostDraw);if(sim.Tick!=nextTick||feedback?.StateSignature!=nextState)throw new Exception("state changed before expiry draw");Capture("expiry",nextBits);}
 GD.Print("NATURAL_PLAYER_EXPIRE_PASS tick="+nextTick+" newDamage="+nextEvents.Count+" active="+(feedback?.Active??false).ToString()+" headless="+headless);GetTree().Quit();return;}
 if(++frame>500||sim.Phase!=RunPhase.Combat)throw new Exception("no natural Ricochet before terminal");
 }catch(Exception e){ready=false;SetProcess(false);GD.PushError(e.ToString());GetTree().Quit(1);}}
